    async def confirm_{{ node.id | replace(' ', '_') | replace('-', '_') | replace('.', '_') }}(
        self{% for cap in node.capture %}{% set py_type = 'str' %}{% if cap.type == 'number' %}{% set py_type = 'float' %}{% elif cap.type == 'boolean' %}{% set py_type = 'bool' %}{% else %}{% set py_type = 'str' %}{% endif %},
        {% if cap.multi %}{{ cap.name | replace(' ', '_') | replace('-', '_') | replace('.', '_') }}: Optional[List[str]] = None{% else %}{% if cap.required %}{{ cap.name | replace(' ', '_') | replace('-', '_') | replace('.', '_') }}: {{ py_type }}{% else %}{{ cap.name | replace(' ', '_') | replace('-', '_') | replace('.', '_') }}: Optional[{{ py_type }}] = None{% endif %}{% endif %}{% endfor %}
    ) -> Optional[Agent]:
        """Record all fields for {{ node.id }} and {{ 'advance' if has_single_edge else 'then choose the next step' }}.
        {% for cap in node.capture %}- {{ cap.name }}{% if cap.enum %} (allowed: {{ cap.enum }}){% endif %}{% if cap.description %}: {{ cap.description }}{% endif %}
        {% endfor %}"""
        flow_state: FlowState = self.session.userdata
        # Persist provided values
        {% for cap in node.capture %}
        {% set pname = cap.name | replace(' ', '_') | replace('-', '_') | replace('.', '_') %}
        {% if cap.multi %}
        if {{ pname }} is not None:
            flow_state.set_slot("{{ cap.name }}", list({{ pname }}))
        {% else %}
        if {{ pname }} is not None:
            flow_state.set_slot("{{ cap.name }}", {{ pname }})
        {% endif %}
        {% endfor %}
        {% if has_single_edge %}
        # Advance to the single next step
        if FLOW_GENERATION_MODE == "declarative":
            next_agent = self._route_to("{{ node.id }}")
            if next_agent:
                return next_agent
        {% if single_edge.next_class_name %}
        if TEST_MODE:
            logger.info(
                "[GEN-DEBUG] transition node_id=%s node_type=%s from=%s to=%s edge_id=%s edge_type=%s",
                "{{ node.id }}",
                "{{ node.type }}",
                "{{ single_edge.from_node_id }}",
                "{{ single_edge.to_node_id }}",
                "{{ single_edge.edge_id }}",
                "{{ single_edge.edge_type }}",
            )
        return {{ single_edge.next_class_name }}(job_context=self.job_context)
        {% else %}
        # Multiple edges: confirm only; LLM must call the desired edge tool next
        if TEST_MODE:
            logger.info("[GEN-DEBUG] confirmed node=%s; awaiting edge tool", "{{ node.id }}")
        return None
        {% endif %}
    {% endif %}
    {% endif %}
    {% for edge in node.out_edges %}
    @function_tool
    async def {{ edge.tool_name }}(self) -> Optional[Agent]:
        """{{ edge.description }}"""
        flow_state: FlowState = self.session.userdata
        # First user-driven action: enable preemptive generation for low-latency thereafter
        self._enable_preemptive_generation()
        
        if FLOW_GENERATION_MODE == "declarative":
            # In declarative mode, prefer central router decision
            next_agent = self._route_to("{{ node.id }}")
            if next_agent:
                return next_agent
        
        {% if edge.next_class_name %}
        if TEST_MODE:
            logger.info(
                "[GEN-DEBUG] transition node_id=%s node_type=%s from=%s to=%s edge_id=%s edge_type=%s",
                "{{ node.id }}",
                "{{ node.type }}",
                "{{ edge.from_node_id }}",
                "{{ edge.to_node_id }}",
                "{{ edge.edge_id }}",
                "{{ edge.edge_type }}",
            )
        return {{ edge.next_class_name }}(job_context=self.job_context)
        {% else %}
        # Terminal edge
        if TEST_MODE:
            logger.info(
                "[GEN-DEBUG] transition node_id=%s node_type=%s from=%s to=%s edge_id=%s edge_type=%s",
                "{{ node.id }}",
                "{{ node.type }}",
                "{{ edge.from_node_id }}",
                None,
                "{{ edge.edge_id }}",
                "{{ edge.edge_type }}",
            )
        await self._handle_terminal()
        return None
        {% endif %}

    {% endfor %}
    {% endif %}

    {% if not node.out_edges or node.out_edges | selectattr('next_class_name', 'none') | list %}
    async def _handle_terminal(self):
        """Handle terminal node - run post-call analysis and end call"""
        await self._run_post_call_analysis()
        await self.end_call_if_needed()
    {% endif %}
    
    async def _run_post_call_analysis(self):
        """Run post-call analysis if configured"""
        {% if flow.post_call_analysis %}
        try:
            flow_state: FlowState = self.session.userdata
            
            # Build analysis prompt
            analysis_prompt = f"""
            Analyze this conversation session and provide structured analysis.
            
            Session Path: {' -> '.join(flow_state.path)}
            Collected Data: {json.dumps(flow_state.slots, indent=2)}
            Task Results: {json.dumps(flow_state.task_results, indent=2)}
            
            Return strict JSON with these fields:
{% for item in flow.post_call_analysis.analysis_items %}
            - {{ item.name }} ({{ item.type }}): {{ item.description }}
{% endfor %}
            """
            
            # Call OpenAI for analysis
            analysis_llm = openai.LLM(model="{{ flow.post_call_analysis.model }}")
            response = await analysis_llm.agenerate(analysis_prompt)
            
            try:
                analysis_result = json.loads(response.choices[0].message.content)
                logger.info(f"Post-call analysis: {analysis_result}")
                flow_state.task_results["_post_call_analysis"] = analysis_result
            except json.JSONDecodeError as e:
                logger.error(f"Failed to parse analysis JSON: {e}")
                
        except Exception as e:
            logger.error(f"Post-call analysis failed: {e}")
        {% else %}
        logger.info("No post-call analysis configured")
        {% endif %}

{% endfor %}


def prewarm(proc):
    """Prewarm VAD model"""
    proc.userdata["vad"] = silero.VAD.load()


async def entrypoint(ctx: JobContext) -> None:
    """Main entrypoint for the generated agent"""
    # Logging setup
    ctx.log_context_fields = {
        "room": ctx.room.name,
        "flow": "{{ flow.url_id }}"
    }
    
    # Create agent session with proper configuration
    session = AgentSession(
        llm=openai.LLM(
            model="{{ flow.llm.model }}",
            temperature={{ flow.llm.temperature }},
            {% if flow.llm.max_tokens %}max_output_tokens={{ flow.llm.max_tokens }}{% endif %}
        ),
        {% if flow.stt_provider == "google" %}
        stt=deepgram.STT(model="nova-2"),
        {% elif flow.stt_provider == "aws" %}
        stt=deepgram.STT(model="nova-2"),  # Fallback to deepgram
        {% else %}
        stt=deepgram.STT(model="nova-2"),
        {% endif %}
        {% if flow.tts.voice_id %}
        tts=elevenlabs.TTS(
            api_key=(os.getenv("ELEVEN_API_KEY") or os.getenv("ELEVENLABS_API_KEY")),
            model="{{ flow.tts.model }}",
            voice_id="{{ flow.tts.voice_id }}"
        ),
        {% else %}
        tts=elevenlabs.TTS(
            api_key=(os.getenv("ELEVEN_API_KEY") or os.getenv("ELEVENLABS_API_KEY")),
            model="{{ flow.tts.model }}"
        ),
        {% endif %}
        vad=ctx.proc.userdata["vad"],
        preemptive_generation=(os.getenv("PREEMPTIVE_FIRST_TURN", "false").lower() == "true")
    )
    
    # Initialize FlowState
    session.userdata = FlowState()
    
    # Start with the designated start node
    start_agent = {{ flow.start_class_name }}(job_context=ctx)
    
    # Start session
    await session.start(
        agent=start_agent,
        room=ctx.room
    )
    
    # Connect to room
    await ctx.connect()


if __name__ == "__main__":
    cli.run_app(WorkerOptions(
        entrypoint_fnc=entrypoint,
        prewarm_fnc=prewarm
    ))