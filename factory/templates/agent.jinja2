        """Continue to next node after user confirmation or function completion"""
        if FLOW_GENERATION_MODE == "declarative":
            next_agent = self._route_to("{{ node.id }}")
            if next_agent:
                return next_agent
        {% if node.out_edges %}
        {% set edge = node.out_edges[0] %}
        {% if edge.next_class_name %}
        if TEST_MODE:
            logger.info(
                "[GEN-DEBUG] transition node_id=%s node_type=%s from=%s to=%s edge_id=%s edge_type=%s",
                "{{ node.id }}",
                "{{ node.type }}",
                "{{ edge.from_node_id }}",
                "{{ edge.to_node_id }}",
                "{{ edge.edge_id }}",
                "{{ edge.edge_type }}",
            )
        return {{ edge.next_class_name }}(job_context=self.job_context)
        {% else %}
        # Terminal edge
        if TEST_MODE:
            logger.info(
                "[GEN-DEBUG] transition node_id=%s node_type=%s from=%s to=%s edge_id=%s edge_type=%s",
                "{{ node.id }}",
                "{{ node.type }}",
                "{{ edge.from_node_id }}",
                None,
                "{{ edge.edge_id }}",
                "{{ edge.edge_type }}",
            )
        await self._handle_terminal()
        return None
        {% endif %}
        {% else %}
        # Terminal function node
        if TEST_MODE:
            logger.info("[GEN-DEBUG] terminal node_id=%s node_type=%s", "{{ node.id }}", "{{ node.type }}")
        await self._handle_terminal()
        return None
        {% endif %}

    {% endif %}

    {% if node.type == "conversation" %}
    {# All conversation nodes: edge tools for navigation (capture field is inert for now) #}
    {% for edge in node.out_edges %}
    @function_tool
    async def {{ edge.tool_name }}(self) -> Optional[Agent]:
        """{{ edge.description }}{% if node.out_edges|length > 1 %} — ملاحظة: استخدم أداة واحدة فقط في هذا الدور؛ لا تجمع أكثر من أداة.{% endif %}"""
        flow_state: FlowState = self.session.userdata
        self._enable_preemptive_generation()

        if FLOW_GENERATION_MODE == "declarative":
            next_agent = self._route_to("{{ node.id }}")
            if next_agent:
                return next_agent

        {% if edge.next_class_name %}
        if TEST_MODE:
            logger.info(
                "[GEN-DEBUG] transition node_id=%s node_type=%s from=%s to=%s edge_id=%s edge_type=%s",
                "{{ node.id }}",
                "{{ node.type }}",
                "{{ edge.from_node_id }}",
                "{{ edge.to_node_id }}",
                "{{ edge.edge_id }}",
                "{{ edge.edge_type }}",
            )
        return {{ edge.next_class_name }}(job_context=self.job_context)
        {% else %}
        if TEST_MODE:
            logger.info(
                "[GEN-DEBUG] transition node_id=%s node_type=%s from=%s to=%s edge_id=%s edge_type=%s",
                "{{ node.id }}",
                "{{ node.type }}",
                "{{ edge.from_node_id }}",
                None,
                "{{ edge.edge_id }}",
                "{{ edge.edge_type }}",
            )
        await self._handle_terminal()
        return None
        {% endif %}
    {% endfor %}
    {% endif %}

    {% if not node.out_edges or node.out_edges | selectattr('next_class_name', 'none') | list %}
    async def _handle_terminal(self):
        """Handle terminal node - end call"""
        await self.end_call_if_needed()
    {% endif %}

{% endfor %}


def prewarm(proc):
    """Prewarm VAD model"""
    proc.userdata["vad"] = silero.VAD.load()


async def entrypoint(ctx: JobContext) -> None:
    """Main entrypoint for the generated agent"""
    # Logging setup
    ctx.log_context_fields = {
        "room": ctx.room.name,
        "flow": "{{ flow.url_id }}"
    }
    
    # Create agent session with proper configuration
    # LLM selection
    {% if flow.llm.provider == 'openai' %}
    _llm = openai.LLM(model="{{ flow.llm.model }}", temperature={{ flow.llm.temperature }}, {% if flow.llm.max_tokens %}max_output_tokens={{ flow.llm.max_tokens }}{% endif %})
    {% elif flow.llm.provider == 'azure' %}
    # Prefer Azure OpenAI if available; otherwise fallback to standard OpenAI
    try:
        _llm = openai.LLM.with_azure(
            azure_deployment=os.getenv('AZURE_OPENAI_DEPLOYMENT') or '{{ flow.llm.model }}',
            azure_endpoint=os.getenv('AZURE_OPENAI_ENDPOINT'),
            api_key=os.getenv('AZURE_OPENAI_API_KEY'),
            api_version=os.getenv('OPENAI_API_VERSION') or '2024-10-01-preview',
            temperature={{ flow.llm.temperature }},
            max_output_tokens={{ flow.llm.max_tokens or 'None' }}
        )
    except Exception:
        _llm = openai.LLM(model="{{ flow.llm.model }}", temperature={{ flow.llm.temperature }})
    {% elif flow.llm.provider == 'google' %}
    if google is None:
        _llm = openai.LLM(model="{{ flow.llm.model }}", temperature={{ flow.llm.temperature }}, {% if flow.llm.max_tokens %}max_output_tokens={{ flow.llm.max_tokens }}{% endif %})
    else:
        _llm = google.LLM(model="{{ flow.llm.model }}", temperature={{ flow.llm.temperature }}, {% if flow.llm.max_tokens %}max_output_tokens={{ flow.llm.max_tokens }}{% endif %})
    {% else %}
    _llm = openai.LLM(model="{{ flow.llm.model }}", temperature={{ flow.llm.temperature }})
    {% endif %}

    # STT selection
    {% if flow.stt.provider == 'azure' %}
    if azure is None:
        _stt = deepgram.STT(model='nova-2')
    else:
        _stt = azure.STT(language='{{ flow.stt.language }}')
    {% elif flow.stt.provider == 'aws' %}
    if aws is None:
        _stt = deepgram.STT(model='nova-2')
    else:
        _stt = aws.STT(language='{{ flow.stt.language }}')
    {% elif flow.stt.provider == 'google' %}
    if google is None:
        logger.warning('Google STT plugin not available, falling back to Deepgram')
        _stt = deepgram.STT(model='nova-2')
    else:
        _stt = google.STT(language='{{ flow.stt.language }}')
    {% elif flow.stt.provider == 'deepgram' %}
    _stt = deepgram.STT(model='{{ flow.stt.model or 'nova-3' }}')
    {% else %}
    logger.warning("Unsupported STT provider '{{ flow.stt.provider }}', defaulting to Deepgram")
    _stt = deepgram.STT(model='nova-2')
    {% endif %}

    # TTS selection
    {% if flow.tts.provider == 'aws' %}
    if aws is None:
        _tts = elevenlabs.TTS(api_key=(os.getenv('ELEVEN_API_KEY') or os.getenv('ELEVENLABS_API_KEY')), model='{{ flow.tts.model }}')
    else:
        _tts = aws.TTS(voice='{{ flow.tts.voice_id or (os.getenv('AWS_TTS_VOICE') or 'Joanna') }}', speech_engine='{{ flow.tts.speech_engine or (os.getenv('AWS_TTS_ENGINE') or 'neural') }}', language=os.getenv('AWS_TTS_LANGUAGE') or 'en-US')
    {% else %}
    {% if flow.tts.voice_id %}
    _tts = elevenlabs.TTS(api_key=(os.getenv('ELEVEN_API_KEY') or os.getenv('ELEVENLABS_API_KEY')), model='{{ flow.tts.model }}', voice_id='{{ flow.tts.voice_id }}')
    {% else %}
    _tts = elevenlabs.TTS(api_key=(os.getenv('ELEVEN_API_KEY') or os.getenv('ELEVENLABS_API_KEY')), model='{{ flow.tts.model }}')
    {% endif %}
    {% endif %}

    session = AgentSession(
        llm=_llm,
        stt=_stt,
        tts=_tts,
        vad=ctx.proc.userdata["vad"]
    )

    if hasattr(session, "preemptive_generation"):
        session.preemptive_generation = (
            os.getenv("PREEMPTIVE_FIRST_TURN", "false").lower() == "true"
        )
    
    # Initialize FlowState
    session.userdata = FlowState()
    
    # Start with the designated start node
    start_agent = {{ flow.start_class_name }}(job_context=ctx)
    
    # Start session
    await session.start(
        agent=start_agent,
        room=ctx.room
    )
    
    # Connect to room
    await ctx.connect()


if __name__ == "__main__":
    cli.run_app(WorkerOptions(
        entrypoint_fnc=entrypoint,
        prewarm_fnc=prewarm
    ))