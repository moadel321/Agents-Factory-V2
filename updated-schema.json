{
  "imports": {
    "datetime": "from datetime import datetime",
    "typing": "from typing import Optional, Union, Literal, Annotated, List, Dict",
    "pydantic": "from pydantic import BaseModel, Field"
  },
  "definitions": {
    "CallSettings": {
      "who_speaks_first": "Literal['user', 'agent']",
      "end_call_on_silence_ms": "int",
      "max_call_duration_ms": "int"
    },
    "STTSettings": {
      "provider": "Literal['google', 'aws', 'azure', 'deepgram']", // NEW: added 'azure' and 'deepgram' providers (see README §2 STT Settings)
      "language": "Literal['en-US', 'ar-SA']",
      "model": "Optional[str]" // NEW: optional provider-specific model (e.g., Deepgram 'nova-3')
    },
    "AWSTTSSettings": {
      "tts_provider": "Literal['aws']",
      "voice_id": "str",
      "speech_engine": "Literal['neural']"
    },
    "ElevenLabsTTSSettings_VoiceSettings": {
      "stability": "float",
      "similarity_boost": "float",
      "style": "Optional[float]",
      "speed": "Optional[float]",
      "use_speaker_boost": "Optional[bool]"
    },
    "ElevenLabsTTSSettings": {
      "tts_provider": "Literal['elevenlabs']",
      "model": "Literal['eleven_multilingual_v2', 'eleven_flash_v2_5', 'eleven_flash_v2', 'eleven_turbo_v2_5', 'eleven_turbo_v2']", // NEW: constrained model set vs free-text (see README §3 TTS Settings)
      "voice_id": "str",
      "voice_settings": "ElevenLabsTTSSettings_VoiceSettings"
    },
    "TTSSettings": "Annotated[Union[AWSTTSSettings, ElevenLabsTTSSettings], Field(discriminator='tts_provider')]",
    "LLMSettings": {
      "provider": "Literal['openai', 'azure', 'google']", // NEW: added 'azure' (see README §4 LLM Settings)
      "model": "str", // NEW: broadened from Literal['gpt-4.1'] to str for flexibility
      "temperature": "float",
      "max_tokens": "Optional[int]"
    },

    "DisplayPosition": { // NEW: UI position for nodes/flow (used by visualizer)
      "x": "float",
      "y": "float"
    },
    "LLMSimpleOverrides": { // NEW: per-node LLM overrides (see README §8 ConversationSettings)
      "provider": "Optional[Literal['openai', 'azure', 'google']]",
      "model": "Optional[str]",
      "temperature": "Optional[float]",
      "max_tokens": "Optional[int]"
    },
    "GlobalSettings_FinetuneExample_ConversationExample": { // NEW vs original (Global finetune was commented out)
      "speaker": "Literal['user', 'agent']",
      "text": "str"
    },
    "GlobalSettings_FinetuneExample": { // NEW: enabled finetune examples under GlobalSettings
      "type": "Literal['jump', 'not_jump']",
      "conversations": "List[GlobalSettings_FinetuneExample_ConversationExample]"
    },
    "GlobalSettings": {
      "prompt": "str",
      "finetune_examples": "List[GlobalSettings_FinetuneExample]" // NEW: previously commented out in original
    },
    "ConversationSettings_CaptureField": { // NEW: declarative capture fields (see README §8)
      "name": "str",
      "type": "Literal['string', 'number', 'boolean', 'enum']",
      "enum": "Optional[List[str]]",
      "multi": "Optional[bool]",
      "required": "Optional[bool]",
      "description": "Optional[str]"
    },
    "ConversationSettings_FinetuneExample_ConversationExample": { // NEW: conversation-level finetuning support
      "speaker": "Literal['user', 'agent']",
      "text": "str"
    },
    "ConversationSettings_FinetuneExample": { // NEW: conversation finetune container
      "type": "Literal['conversation']",
      "conversations": "List[ConversationSettings_FinetuneExample_ConversationExample]"
    },
    "ConversationSettings": {
      "type": "Literal['conversation']",
      "on_enter_text": "str",
      "on_enter_type": "Literal['prompt', 'static']",
      "allow_interruptions": "bool",
      "skip_response": "bool",
      "finetune_examples": "List[ConversationSettings_FinetuneExample]", // NEW: per-node finetuning examples
      "llm_overrides": "Optional[LLMSimpleOverrides]", // NEW: per-node LLM overrides
      "capture": "Optional[List[ConversationSettings_CaptureField]]" // NEW: structured captures -> tools
    },
    "FunctionSettings_SpeakDuringExecution": { // NEW: structured speech while function runs (see README §9)
      "mode": "Literal['static', 'prompt']",
      "text": "Optional[str]",
      "instructions": "Optional[str]"
    },
    "FunctionSettings": {
      "url": "str", // NEW: flattened from original FunctionCallBody.endpoint
      "method": "Literal['GET', 'POST', 'PUT', 'DELETE', 'PATCH']", // NEW: moved out of FunctionCallBody
      "headers": "Optional[Dict[str, str]]", // NEW: moved out of FunctionCallBody
      "body": "Optional[Dict]", // NEW: simplified generic body vs typed FunctionCallBody
      "timeout_ms": "int", // NEW: execution timeout
      "retries": "int", // NEW: retry count
      "speak_during_execution": "Optional[FunctionSettings_SpeakDuringExecution]", // NEW: replaces boolean speak flags with structured config
      "wait_for_result": "bool" // NEW: replaces original wait_for_completion
    },
    "EdgePrompt": {
      "prompt": "str",
      "name": "Optional[str]" // NEW: optional code-friendly name used for tool naming
    },
    "NodeOut": {
      "id": "str",
      "created": "datetime", // NEW: timestamp (authoring convenience)
      "updated": "datetime", // NEW: timestamp (authoring convenience)
      "name": "str",
      "is_global": "bool",
      "global_settings": "Optional[GlobalSettings]",
      "position": "DisplayPosition", // NEW: node UI position
      "type": "Literal['conversation', 'function']",
      "settings": "Union[ConversationSettings, FunctionSettings]"
    },
    "EdgeOut": {
      "id": "str",
      "created": "datetime", // NEW: timestamp (authoring convenience)
      "updated": "datetime", // NEW: timestamp (authoring convenience)
      "from_node_id": "str",
      "to_node_id": "Optional[str]",
      "type": "Literal['prompt', 'skip']",
      "settings": "Optional[EdgePrompt]"
    },
    "ConversationFlowOut": {
      "id": "str",
      "url_id": "str", // NEW: short id used for file/agent naming
      "created": "datetime", // NEW: flow-level timestamp
      "updated": "datetime", // NEW: flow-level timestamp
      "name": "str",
      "instructions": "str",
      "stt_settings": "STTSettings",
      "tts_settings": "TTSSettings",
      "llm_settings": "LLMSettings",
      "call_settings": "CallSettings",
      "post_call_analysis": "Optional[PostCallAnalysisSettings]", // NEW: optional PCA (see README Test/Analysis sections)
      "begin_position": "DisplayPosition", // NEW: canvas origin for visualization
      "start_node_id": "Optional[str]",
      "nodes": "List[NodeOut]",
      "edges": "List[EdgeOut]"
    }
  }
}

